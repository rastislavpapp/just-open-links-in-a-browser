# Generated by Gradle updateDaemonJvm. Pins the daemon to a specific JDK and
# embeds foojay download URLs, which would make CI/F-Droid fetch a JDK at
# build time. The project only needs JDK 17+.
gradle/gradle-daemon-jvm.properties
