<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground. Also serves as the Android 13+ monochrome layer,
    where only the alpha channel is used, so the glyph stays in one file.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Browser window with a link arriving in it: the window's left edge is
        open where the arrow comes through. Drawn on a 24x24 grid as 2-unit
        strokes, then scaled and centred in the 108x108 adaptive viewport.
    -->
    <group
        android:translateX="26.8"
        android:translateY="28.2"
        android:scaleX="2.15"
        android:scaleY="2.15">

        <!-- Window frame, broken on the left where the arrow enters. -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M5,9 L5,6 A3,3 0 0 1 8,3 L19,3 A3,3 0 0 1 22,6 L22,18 A3,3 0 0 1 19,21 L8,21 A3,3 0 0 1 5,18" />

        <!-- Chrome bar and its two buttons, which make the frame read as a browser. -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:pathData="M5,9 L22,9" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M7.6,6 A0.9,0.9 0 1 1 9.4,6 A0.9,0.9 0 1 1 7.6,6 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M10.6,6 A0.9,0.9 0 1 1 12.4,6 A0.9,0.9 0 1 1 10.6,6 Z" />

        <!-- The link, entering through the gap. -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:pathData="M1,15 L16,15" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M13,12 L16,15 L13,18" />

    </group>

</vector>
